<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="SCI_PH.PatientPrototype.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SCI_PH.PatientPrototype"
    xmlns:patient="clr-namespace:SCI_PH.PatientPrototype.Features.Patient"

    xmlns:auth="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.Auth"
    xmlns:home="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.Home"
    xmlns:profile="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.Profile"
    xmlns:history="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.History"
    xmlns:results="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.Results"
    xmlns:documents="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.Documents"
    xmlns:ai="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.Ai"

    x:DataType="local:AppShell"
    FlyoutBehavior="Disabled"
    FlyoutBackgroundColor="{StaticResource ColorPrimaryDark}"
    Title="SCI-PH">

    <!-- CABECERA DEL MENU: nombre tomado de la sesión del paciente -->

    <Shell.FlyoutHeader>

        <Grid
            Padding="22,35,22,24"
            BackgroundColor="{StaticResource ColorPrimaryDark}">

            <VerticalStackLayout
                Spacing="8"
                HorizontalOptions="Center">

                <Border
                    WidthRequest="90"
                    HeightRequest="90"
                    BackgroundColor="White"
                    Stroke="White"
                    StrokeThickness="3">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="45" />
                    </Border.StrokeShape>

                    <Image
                        Source="patient_avatar.png"
                        Aspect="AspectFill" />

                </Border>

                <Label
                    Text="{Binding PatientDisplayName}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Grid>

    </Shell.FlyoutHeader>


    <!-- ACCESO DEL PACIENTE -->

    <ShellContent
        Route="{x:Static patient:PatientRoutes.QrAccess}"
        Title="Acceso"
        ContentTemplate="{DataTemplate auth:QrScanPage}"
        Shell.FlyoutItemIsVisible="False" />


    <!-- AREA AUTENTICADA -->

    <FlyoutItem
        Title="Inicio"
        Route="{x:Static patient:PatientRoutes.Home}">

        <ShellContent
            Title="Inicio"
            ContentTemplate="{DataTemplate home:HomePage}" />

    </FlyoutItem>


    <FlyoutItem
        Title="Mi perfil"
        Route="{x:Static patient:PatientRoutes.Profile}">

        <ShellContent
            Title="Mi perfil"
            ContentTemplate="{DataTemplate profile:ProfilePage}" />

    </FlyoutItem>


    <FlyoutItem
        Title="Historial clínico"
        Route="{x:Static patient:PatientRoutes.History}">

        <ShellContent
            Title="Historial clínico"
            ContentTemplate="{DataTemplate history:HistoryPage}" />

    </FlyoutItem>


    <FlyoutItem
        Title="Resultados"
        Route="{x:Static patient:PatientRoutes.Results}">

        <ShellContent
            Title="Resultados"
            ContentTemplate="{DataTemplate results:ResultsPage}" />

    </FlyoutItem>


    <FlyoutItem
        Title="Documentos"
        Route="{x:Static patient:PatientRoutes.Documents}">

        <ShellContent
            Title="Documentos"
            ContentTemplate="{DataTemplate documents:DocumentsPage}" />

    </FlyoutItem>


    <FlyoutItem
        Title="Asistente IA"
        Route="{x:Static patient:PatientRoutes.Assistant}">

        <ShellContent
            Title="SCI-PH AI"
            ContentTemplate="{DataTemplate ai:AiAssistantPage}" />

    </FlyoutItem>


    <!-- CERRAR SESIÓN -->

    <MenuItem
        Text="Cerrar sesión"
        Command="{Binding LogoutCommand}" />

</Shell>
