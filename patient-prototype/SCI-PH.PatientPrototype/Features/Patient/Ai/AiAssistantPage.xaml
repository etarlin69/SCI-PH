<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SCI_PH.PatientPrototype.Features.Patient.Ai.AiAssistantPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.ViewModels"
    xmlns:dtos="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.Models.Dtos"
    xmlns:ai="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.Ai"
    x:DataType="vm:AiAssistantViewModel"
    Title="SCI-PH AI"
    BackgroundColor="#F4F7FB">

    <ContentPage.Resources>

        <!-- MENSAJE DEL ASISTENTE -->
        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="dtos:AssistantMessageDto">
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="9"
                Padding="0,0,50,14">

                <Border
                    WidthRequest="38"
                    HeightRequest="38"
                    BackgroundColor="{StaticResource ColorPrimary}"
                    StrokeThickness="0"
                    VerticalOptions="Start">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>

                    <Label
                        Text="AI"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    BackgroundColor="White"
                    Stroke="#DCE4ED"
                    StrokeThickness="1"
                    HorizontalOptions="Start"
                    MaximumWidthRequest="650">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <Label
                        Text="{Binding Text}"
                        FontSize="16"
                        TextColor="#243B5A"
                        LineBreakMode="WordWrap" />

                </Border>

            </Grid>
        </DataTemplate>

        <!-- MENSAJE DEL PACIENTE -->
        <DataTemplate x:Key="PatientMessageTemplate" x:DataType="dtos:AssistantMessageDto">
            <Grid Padding="50,0,0,14">
                <Border
                    Padding="16"
                    BackgroundColor="{StaticResource ColorPrimary}"
                    Stroke="{StaticResource ColorPrimary}"
                    StrokeThickness="1"
                    HorizontalOptions="End"
                    MaximumWidthRequest="650">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <Label
                        Text="{Binding Text}"
                        FontSize="16"
                        TextColor="White"
                        LineBreakMode="WordWrap" />

                </Border>
            </Grid>
        </DataTemplate>

        <ai:AssistantMessageTemplateSelector
            x:Key="MessageTemplateSelector"
            AssistantTemplate="{StaticResource AssistantMessageTemplate}"
            PatientTemplate="{StaticResource PatientMessageTemplate}" />

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ============================= -->
        <!-- ENCABEZADO DEL ASISTENTE -->
        <!-- ============================= -->

        <Border
            Grid.Row="0"
            Margin="16,16,16,10"
            Padding="18"
            BackgroundColor="White"
            Stroke="#DCE4ED"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="16">

                <!-- CÍRCULO AI -->
                <Border
                    WidthRequest="72"
                    HeightRequest="72"
                    BackgroundColor="{StaticResource ColorPrimary}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="36" />
                    </Border.StrokeShape>

                    <Label
                        Text="AI"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>

                <!-- INFORMACIÓN -->
                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="3">

                    <Label
                        Text="SCI-PH AI"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="#16345F" />

                    <Label
                        Text="Asistente educativo"
                        FontSize="16"
                        TextColor="#3A9B71" />

                    <Label
                        Text="Disponible"
                        FontSize="12"
                        TextColor="#6B7A90" />

                </VerticalStackLayout>

            </Grid>

        </Border>

        <!-- ============================= -->
        <!-- AVISO -->
        <!-- ============================= -->

        <Border
            Grid.Row="1"
            Margin="16,0,16,12"
            Padding="14"
            BackgroundColor="#FFF8EA"
            Stroke="#F0DCAE"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="10">

                <Label
                    Text="ⓘ"
                    FontSize="20"
                    TextColor="#A46A19"
                    VerticalOptions="Start" />

                <Label
                    Grid.Column="1"
                    Text="SCI-PH AI ofrece información educativa. No realiza diagnósticos, no prescribe medicamentos y no sustituye la evaluación de un profesional de salud."
                    FontSize="12"
                    TextColor="#745B30"
                    LineBreakMode="WordWrap" />

            </Grid>

        </Border>

        <!-- ============================= -->
        <!-- ÁREA DE MENSAJES -->
        <!-- ============================= -->

        <CollectionView
            x:Name="MessagesView"
            Grid.Row="2"
            Margin="16,4,16,4"
            SelectionMode="None"
            ItemsSource="{Binding Messages}"
            ItemTemplate="{StaticResource MessageTemplateSelector}"
            ItemsUpdatingScrollMode="KeepLastItemInView" />

        <!-- ============================= -->
        <!-- BARRA DE ESCRITURA -->
        <!-- ============================= -->

        <Grid
            Grid.Row="3"
            BackgroundColor="White"
            Padding="12,10,12,14">

            <Border
                BackgroundColor="#F4F7FA"
                Stroke="#CCD7E3"
                StrokeThickness="1"
                Padding="12,6">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">

                    <!-- TEXTO -->
                    <Editor
                        Grid.Column="0"
                        Text="{Binding Question}"
                        Placeholder="Escribe una pregunta..."
                        PlaceholderColor="#8A97A8"
                        TextColor="#1F3552"
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="46"
                        MaximumHeightRequest="110"
                        MaxLength="300"
                        VerticalOptions="Center" />

                    <!-- ENVIAR -->
                    <Button
                        Grid.Column="1"
                        Text="➤"
                        Command="{Binding SendCommand}"
                        SemanticProperties.Description="Enviar pregunta"
                        WidthRequest="48"
                        HeightRequest="48"
                        CornerRadius="24"
                        Padding="0"
                        FontSize="20"
                        BackgroundColor="{StaticResource ColorPrimary}"
                        TextColor="White"
                        VerticalOptions="End" />

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>
