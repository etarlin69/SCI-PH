<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SCI_PH.PatientPrototype.Features.Patient.History.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Historial clínico"
    BackgroundColor="#F7F9FC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="17">

            <Label
                Text="Historial clínico"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#0F2747" />

            <Label
                Text="Información clínica disponible en tu expediente SCI-PH."
                FontSize="14"
                TextColor="#526175" />

            <!-- ALERGIAS -->

            <Border
                BackgroundColor="White"
                Stroke="#E4E9F0"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Alergias"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="#172B4D" />

                    <Border
                        BackgroundColor="#FFF5F5"
                        StrokeThickness="0"
                        Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Penicilina"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#9F3030" />

                            <Label
                                Text="Severidad moderada"
                                FontSize="13"
                                TextColor="#6E4444" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </Border>

            <!-- CONDICIONES -->

            <Border
                BackgroundColor="White"
                Stroke="#E4E9F0"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="Condiciones médicas"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="#172B4D" />

                    <Label
                        Text="Hipertensión arterial"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#24364F" />

                    <Label
                        Text="Registrada en 2024"
                        FontSize="13"
                        TextColor="#69778A" />

                </VerticalStackLayout>

            </Border>

            <!-- MEDICACIÓN -->

            <Border
                BackgroundColor="White"
                Stroke="#E4E9F0"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="Medicamentos habituales"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="#172B4D" />

                    <Label
                        Text="Losartán 50 mg"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#24364F" />

                    <Label
                        Text="1 tableta cada 24 horas"
                        FontSize="13"
                        TextColor="#69778A" />

                </VerticalStackLayout>

            </Border>

            <!-- EPISODIOS -->

            <Label
                Text="Episodios"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#0F2747" />

            <Border
                BackgroundColor="White"
                Stroke="#E4E9F0"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="7">

                    <Label
                        Text="Emergencia prehospitalaria"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#172B4D" />

                    <Label
                        Text="Hospital Central"
                        FontSize="14"
                        TextColor="#526175" />

                    <Label
                        Text="25 septiembre 2026"
                        FontSize="13"
                        TextColor="#7A8798" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>