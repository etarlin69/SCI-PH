<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SCI_PH.PatientPrototype.Features.Patient.Profile.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mi perfil"
    BackgroundColor="#F7F9FC">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- CABECERA -->
            <Grid
                BackgroundColor="#1976D2"
                Padding="24,30,24,28"
                RowDefinitions="Auto,Auto"
                RowSpacing="24">

                <!-- MÉTRICAS -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,*,*">

                    <VerticalStackLayout
                        Grid.Column="0"
                        HorizontalOptions="Center"
                        Spacing="2">

                        <Label
                            Text="8"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Consultas"
                            FontSize="12"
                            TextColor="#DCE8F8"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        Spacing="2">

                        <Label
                            Text="14"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Resultados"
                            FontSize="12"
                            TextColor="#DCE8F8"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="2"
                        HorizontalOptions="Center"
                        Spacing="2">

                        <Label
                            Text="6"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Documentos"
                            FontSize="12"
                            TextColor="#DCE8F8"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Grid>

                <!-- FOTO Y NOMBRE -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="20">

                    <Grid
                        WidthRequest="132"
                        HeightRequest="132">

                        <Border
                            WidthRequest="132"
                            HeightRequest="132"
                            BackgroundColor="White"
                            Stroke="White"
                            StrokeThickness="4">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="66" />
                            </Border.StrokeShape>

                            <Image
                                x:Name="ProfileImage"
                                Source="patient_avatar.png"
                                Aspect="AspectFill"
                                WidthRequest="132"
                                HeightRequest="132" />

                        </Border>

                        <!-- EDITAR FOTO -->
                        <Button
                            Text="✎"
                            Clicked="OnChangePhotoClicked"
                            WidthRequest="44"
                            HeightRequest="44"
                            CornerRadius="22"
                            BackgroundColor="#21B6C8"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="0,0,2,2" />

                    </Grid>

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="5">

                        <Label
                            Text="Paciente Demo"
                            FontSize="29"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Cuenta del paciente"
                            FontSize="15"
                            TextColor="#DCE8F8" />

                        <Label
                            Text="SCI-PH"
                            FontSize="14"
                            TextColor="#DCE8F8" />

                    </VerticalStackLayout>

                </Grid>

            </Grid>

            <!-- CONTENIDO -->
            <VerticalStackLayout
                Padding="20"
                Spacing="18">

                <!-- SOBRE MI -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E4E9F0"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Sobre mí"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="#172B4D"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Text="Guardar"
                                Clicked="OnSaveDescriptionClicked"
                                BackgroundColor="#1976D2"
                                TextColor="White"
                                CornerRadius="11"
                                HeightRequest="42"
                                Padding="15,7" />

                        </Grid>

                        <Editor
                            x:Name="DescriptionEditor"
                            MinimumHeightRequest="120"
                            AutoSize="TextChanges"
                            Placeholder="Escribe una breve descripción sobre ti..."
                            PlaceholderColor="#8390A0"
                            TextColor="#172B4D"
                            BackgroundColor="#F7F9FC" />

                    </VerticalStackLayout>

                </Border>

                <!-- DESCRIPCIÓN GUARDADA -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E4E9F0"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="9">

                        <Label
                            Text="Descripción del perfil"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            x:Name="PreviewDescriptionLabel"
                            Text="Aquí aparecerá tu descripción."
                            FontSize="14"
                            TextColor="#526175"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>

                <!-- INFORMACIÓN PERSONAL -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E4E9F0"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Información personal"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="Correo electrónico"
                            FontSize="12"
                            TextColor="#778597" />

                        <Label
                            Text="paciente@sciph.local"
                            FontSize="16"
                            TextColor="#24364F" />

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#E4E9F0" />

                        <Label
                            Text="Sexo"
                            FontSize="12"
                            TextColor="#778597" />

                        <Label
                            Text="Masculino"
                            FontSize="16"
                            TextColor="#24364F" />

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#E4E9F0" />

                        <Label
                            Text="Fecha de nacimiento"
                            FontSize="12"
                            TextColor="#778597" />

                        <Label
                            Text="15 de junio de 2000"
                            FontSize="16"
                            TextColor="#24364F" />

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#E4E9F0" />

                        <Label
                            Text="Teléfono"
                            FontSize="12"
                            TextColor="#778597" />

                        <Label
                            Text="809-555-0101"
                            FontSize="16"
                            TextColor="#24364F" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>