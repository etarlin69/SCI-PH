<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SCI_PH.PatientPrototype.Features.Patient.Documents.DocumentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Documentos"
    BackgroundColor="#F7F9FC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="17">

            <Label
                Text="Documentos"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#0F2747" />

            <Label
                Text="Documentos clínicos autorizados para tu cuenta."
                FontSize="14"
                TextColor="#526175" />

            <Border
                BackgroundColor="White"
                Stroke="#E4E9F0"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="14">

                    <Border
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="#EAF4FF"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label
                            Text="📄"
                            FontSize="26"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3">

                        <Label
                            Text="Resumen de alta"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="PDF · Hospital Central"
                            FontSize="13"
                            TextColor="#526175" />

                        <Label
                            Text="02 octubre 2026"
                            FontSize="12"
                            TextColor="#7A8798" />

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Text="Ver"
                        BackgroundColor="#1976D2"
                        TextColor="White"
                        CornerRadius="10"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

            <Border
                BackgroundColor="White"
                Stroke="#E4E9F0"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="14">

                    <Border
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="#ECF8FA"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label
                            Text="📋"
                            FontSize="26"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3">

                        <Label
                            Text="Resultado de laboratorio"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#172B4D" />

                        <Label
                            Text="PDF · Laboratorio"
                            FontSize="13"
                            TextColor="#526175" />

                        <Label
                            Text="28 septiembre 2026"
                            FontSize="12"
                            TextColor="#7A8798" />

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Text="Ver"
                        BackgroundColor="#1976D2"
                        TextColor="White"
                        CornerRadius="10"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>