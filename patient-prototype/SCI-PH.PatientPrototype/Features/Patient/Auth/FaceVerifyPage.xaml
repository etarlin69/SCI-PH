<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SCI_PH.PatientPrototype.Features.Patient.Auth.FaceVerifyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SCI_PH.PatientPrototype.Features.Patient.ViewModels"
    x:DataType="vm:FaceVerifyViewModel"
    Title="Verificación facial"
    BackgroundColor="{StaticResource PatientPageBackground}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <Label
                Text="Verificación facial"
                Style="{StaticResource PatientPageTitleStyle}" />

            <Label
                Text="Confirma tu identidad para continuar."
                FontSize="16"
                TextColor="{StaticResource BodyText}" />

            <Border
                Style="{StaticResource PatientCardStyle}"
                Padding="24">

                <VerticalStackLayout
                    Spacing="18"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="120"
                        HeightRequest="120"
                        BackgroundColor="#EAF2FB"
                        Stroke="{StaticResource ColorPrimary}"
                        StrokeThickness="2">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="60" />
                        </Border.StrokeShape>

                        <Label
                            Text="FACE"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{StaticResource ColorPrimary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Text="Simulación de verificación facial 1:1"
                        FontSize="16"
                        TextColor="#243B5A"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="{Binding StatusMessage}"
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center" />

                    <Button
                        Text="Verificar identidad"
                        Command="{Binding VerifyCommand}"
                        BackgroundColor="{StaticResource ColorPrimary}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        HorizontalOptions="Fill" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
