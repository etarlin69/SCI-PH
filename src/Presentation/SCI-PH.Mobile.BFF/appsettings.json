{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "sci-ph",
    "Audience": "sci-ph-mobile",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "ClockSkewSeconds": 30,
    "MfaChallengeLifetimeMinutes": 5
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 20,
    "AuthenticationWindowSeconds": 60,
    "PatientSelfServicePermitLimit": 60,
    "PatientSelfServiceWindowSeconds": 60,
    "PatientQrPermitLimit": 10,
    "PatientQrWindowSeconds": 60,
    "PatientQrResolvePermitLimit": 30,
    "PatientQrResolveWindowSeconds": 60,
    "PatientDocumentResolvePermitLimit": 10,
    "PatientDocumentResolveWindowSeconds": 60
  }
}
