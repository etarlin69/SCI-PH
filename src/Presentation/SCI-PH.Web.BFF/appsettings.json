{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "sci-ph",
    "Audience": "sci-ph-web",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "ClockSkewSeconds": 30,
    "MfaChallengeLifetimeMinutes": 5
  },
  "IdentityBootstrap": {
    "Enabled": false
  },
  "Security": {
    "AllowedOrigins": []
  },
  "Email": {
    "Mode": "Smtp"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": false,
    "UserName": "",
    "FromAddress": "",
    "FromName": "SCI-PH"
  },
  "AccountEmail": {
    "ActivationUrl": "",
    "ConfirmEmailUrl": "",
    "ResetPasswordUrl": "",
    "InvitationLifetimeHours": 24
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 20,
    "AuthenticationWindowSeconds": 60,
    "AccountRecoveryPermitLimit": 5,
    "AccountRecoveryWindowSeconds": 900
  }
}
