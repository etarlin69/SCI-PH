# Copiar a .env.development.local (ignorado por git). Sin secretos: son URLs y rutas locales.

# Web BFF de desarrollo (SCI-PH.Web.BFF, perfil "https" de launchSettings.json). Vite redirige /api a esta URL.
VITE_WEB_BFF_URL=https://localhost:7003

# Opcional: servir la SPA por HTTPS con el certificado de desarrollo de .NET.
#   dotnet dev-certs https --trust
#   dotnet dev-certs https --export-path ./.certs/localhost.pem --format Pem --no-password
# VITE_DEV_HTTPS_CERT=./.certs/localhost.pem
# VITE_DEV_HTTPS_KEY=./.certs/localhost.key

# Opcional, solo para despliegues donde la SPA y el BFF no comparten origen (por defecto vacío = mismo origen).
# VITE_API_BASE_URL=https://bff.example.org
