# Plantilla de variables para docker-compose.yml.
# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.

POSTGRES_DB=sciph_dev
POSTGRES_USER=sciph
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_PORT=5432

# Clave de firma JWT para los BFF (mínimo 32 bytes). Genera una propia, por ejemplo con
# `openssl rand -base64 48`. El valor de ejemplo es demasiado corto a propósito: los BFF no arrancan
# hasta que lo reemplaces.
JWT_SIGNING_KEY=REPLACE_ME

AZURITE_BLOB_PORT=10000

# Administrador inicial (solo Web BFF, IdentitySeeder). Es idempotente: crea la cuenta si no existe y le asigna el rol
# Administrator. La contraseña de ejemplo no cumple la política (mayúsculas, minúsculas, dígito, símbolo), así que el
# Web BFF no arranca hasta que la reemplaces. Usa credenciales solo locales y nunca las subas al repositorio.
IDENTITY_BOOTSTRAP_ENABLED=true
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME
