# Plantilla de variables para docker-compose.yml.
# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.

POSTGRES_DB=sciph_dev
POSTGRES_USER=sciph
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_PORT=5432

# Clave de firma JWT para los BFF (mínimo 32 bytes). Genera una propia, por ejemplo con
# `openssl rand -base64 48`. El valor de ejemplo es demasiado corto a propósito: los BFF no arrancan
# hasta que lo reemplaces.
JWT_SIGNING_KEY=REPLACE_ME

AZURITE_BLOB_PORT=10000
