<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SCI_PH.Mobile.Features.Paramedic.ViewModels"
             xmlns:dto="clr-namespace:SCI_PH.Mobile.Features.Paramedic.Models.Dtos"
             x:Class="SCI_PH.Mobile.Features.Paramedic.Views.ProceduresPage"
             x:DataType="vm:ProceduresViewModel"
             Style="{StaticResource SciPage}"
             Title="Procedimientos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Procedimientos" Style="{StaticResource SciTitle}" />
                <Label Text="Registra cada procedimiento realizado. Puedes agregar varios o ninguno."
                       Style="{StaticResource SciSubtitle}" />
            </VerticalStackLayout>

            <!-- Formulario -->
            <Border Style="{StaticResource SciCard}">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Procedimiento" Style="{StaticResource SciFieldLabel}" />
                        <Border Style="{StaticResource SciField}">
                            <Picker Title="Selecciona un procedimiento"
                                    ItemsSource="{Binding CatalogItems}"
                                    ItemDisplayBinding="{Binding Name, x:DataType=dto:CatalogItemDto}"
                                    SelectedItem="{Binding SelectedProcedure}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource SciText}" />
                        </Border>
                        <Label Text="{Binding SelectedProcedureDescription}"
                               IsVisible="{Binding HasSelectedProcedureDescription}"
                               Style="{StaticResource SciSubtitle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Resultado (opcional)" Style="{StaticResource SciFieldLabel}" />
                        <Border Style="{StaticResource SciField}">
                            <Editor Text="{Binding Outcome}"
                                    Placeholder="Resultado del procedimiento"
                                    Style="{StaticResource SciEditor}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="80"
                                    MaxLength="4000" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error -->
                    <Border Style="{StaticResource SciErrorBanner}" IsVisible="{Binding HasError}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="{StaticResource SciDanger}" FontSize="13" />
                            <Button Text="Reintentar carga"
                                    Command="{Binding LoadCatalogCommand}"
                                    IsVisible="{Binding CatalogLoadFailed}"
                                    Style="{StaticResource SciSecondaryButton}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Loading -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource SciPrimary}" />

                    <Button Text="Guardar procedimiento"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource SciPrimaryButton}" />
                </VerticalStackLayout>
            </Border>

            <!-- Registrados -->
            <Border Style="{StaticResource SciCard}" IsVisible="{Binding HasSaved}">
                <VerticalStackLayout Spacing="10">
                    <Border Style="{StaticResource SciBadgeSuccess}" HorizontalOptions="Start">
                        <Label Text="Procedimientos registrados"
                               TextColor="{StaticResource SciSuccess}"
                               FontAttributes="Bold" FontSize="13" />
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SavedSummaries}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}"
                                       TextColor="{StaticResource SciText}"
                                       FontSize="14" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Continuar a medicamentos"
                    Command="{Binding ContinueCommand}"
                    Style="{StaticResource SciSecondaryButton}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
