<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SCI_PH.Mobile.Features.Paramedic.ViewModels"
             x:Class="SCI_PH.Mobile.Features.Paramedic.Views.ParamedicHomePage"
             x:DataType="vm:ParamedicHomeViewModel"
             Style="{StaticResource SciPage}"
             Title="Atención prehospitalaria">

    <!-- Cierre de la sesión del personal clínico (ClinicalAccountViewModel; se enlaza en el code-behind). -->
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="AccountSecurityToolbarItem" Text="Cuenta" AutomationId="ClinicalAccountSecurity" Order="Secondary" />
        <ToolbarItem x:Name="LogoutToolbarItem" Text="Cerrar sesión" AutomationId="ClinicalLogout" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- Encabezado -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Inicio" Style="{StaticResource SciTitle}" />
                    <Label Text="{Binding DisplayName, StringFormat='Sesión: {0}'}" Style="{StaticResource SciSubtitle}" />
                </VerticalStackLayout>

                <Button Text="Nueva emergencia"
                        AutomationId="NewEmergency"
                        Command="{Binding NewEmergencyCommand}"
                        Style="{StaticResource SciPrimaryButton}" />

                <!-- Emergencias activas -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Emergencias activas" Style="{StaticResource SciFieldLabel}" FontSize="16" />

                    <ActivityIndicator IsRunning="{Binding IsOpening}"
                                       IsVisible="{Binding IsOpening}"
                                       Color="{StaticResource SciPrimary}" />

                    <!-- Error + reintentar -->
                    <Border Style="{StaticResource SciErrorBanner}" IsVisible="{Binding HasError}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource SciDanger}" FontSize="13" />
                            <Button Text="Reintentar"
                                    Command="{Binding LoadCommand}"
                                    Style="{StaticResource SciSecondaryButton}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Vacía -->
                    <Border Style="{StaticResource SciCard}" IsVisible="{Binding IsEmpty}">
                        <Label Text="No tienes emergencias activas."
                               Style="{StaticResource SciSubtitle}"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <!-- Lista -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Emergencies}" Spacing="10"
                                         IsVisible="{Binding HasEmergencies}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActiveEmergencyItem">
                                <Border Style="{StaticResource SciCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:ParamedicHomeViewModel}}, x:DataType=vm:ParamedicHomeViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Identity.Primary}"
                                               TextColor="{StaticResource SciText}"
                                               FontAttributes="Bold" FontSize="16"
                                               LineBreakMode="CharacterWrap" />
                                        <Label Text="{Binding Identity.Secondary}"
                                               IsVisible="{Binding Identity.HasSecondary}"
                                               TextColor="{StaticResource SciTextMuted}"
                                               FontSize="12" LineBreakMode="CharacterWrap" />
                                        <Label Text="{Binding ChiefComplaint}"
                                               IsVisible="{Binding HasChiefComplaint}"
                                               TextColor="{StaticResource SciText}"
                                               FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding StartedText}" TextColor="{StaticResource SciTextMuted}" FontSize="13"
                                                   VerticalOptions="Center" />
                                            <Border Style="{StaticResource SciBadgeSuccess}">
                                                <Label Text="{Binding StatusText}" TextColor="{StaticResource SciSuccess}"
                                                       FontAttributes="Bold" FontSize="12" />
                                            </Border>
                                            <Border Style="{StaticResource SciBadgeWarning}" IsVisible="{Binding HasTransfer}">
                                                <Label Text="{Binding TransferText}" TextColor="{StaticResource SciWarning}"
                                                       FontAttributes="Bold" FontSize="12" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
