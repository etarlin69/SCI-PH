<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SCI_PH.Mobile.Features.Patient.Profile.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SCI_PH.Mobile.Features.Patient.ViewModels"
    x:DataType="vm:ProfileViewModel"
    Title="Mi perfil"
    BackgroundColor="{StaticResource PatientPageBackground}">

    <ContentPage.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource MutedText}" />
        </Style>
        <Style x:Key="FieldValueStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource TitleText}" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetricLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource OnDarkMutedText}" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- CABECERA -->
            <Grid
                BackgroundColor="{StaticResource ColorPrimary}"
                Padding="24,30,24,28"
                RowDefinitions="Auto,Auto"
                RowSpacing="24">

                <!-- MÉTRICAS -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,*,*">

                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding Profile.Encounters}" Style="{StaticResource MetricValueStyle}" />
                        <Label Text="Atenciones" Style="{StaticResource MetricLabelStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding Profile.Results}" Style="{StaticResource MetricValueStyle}" />
                        <Label Text="Resultados" Style="{StaticResource MetricLabelStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding Profile.ActiveAllergies}" Style="{StaticResource MetricValueStyle}" />
                        <Label Text="Alergias activas" Style="{StaticResource MetricLabelStyle}" />
                    </VerticalStackLayout>

                </Grid>

                <!-- FOTO Y NOMBRE -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="20">

                    <Grid
                        WidthRequest="132"
                        HeightRequest="132">

                        <Border
                            WidthRequest="132"
                            HeightRequest="132"
                            BackgroundColor="White"
                            Stroke="White"
                            StrokeThickness="4">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="66" />
                            </Border.StrokeShape>

                            <Image
                                Source="{Binding PhotoSource}"
                                Aspect="AspectFill"
                                WidthRequest="132"
                                HeightRequest="132" />

                        </Border>

                        <!-- EDITAR FOTO -->
                        <Button
                            Text="✎"
                            Command="{Binding ChangePhotoCommand}"
                            SemanticProperties.Description="Cambiar foto de perfil"
                            WidthRequest="44"
                            HeightRequest="44"
                            CornerRadius="22"
                            BackgroundColor="{StaticResource ColorSecondary}"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="0,0,2,2" />

                    </Grid>

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="5">

                        <Label
                            Text="{Binding Profile.DisplayName}"
                            FontSize="29"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Cuenta del paciente"
                            FontSize="15"
                            TextColor="{StaticResource OnDarkMutedText}" />

                        <Label
                            Text="SCI-PH"
                            FontSize="14"
                            TextColor="{StaticResource OnDarkMutedText}" />

                    </VerticalStackLayout>

                </Grid>

            </Grid>

            <!-- CONTENIDO -->
            <VerticalStackLayout
                Padding="20"
                Spacing="18">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource ColorPrimary}" />

                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    Style="{StaticResource ErrorTextStyle}" />

                <!-- SOBRE MI -->
                <Border Style="{StaticResource PatientCardStyle}">

                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Sobre mí"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TitleText}"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Text="Guardar"
                                Command="{Binding SaveDescriptionCommand}"
                                BackgroundColor="{StaticResource ColorPrimary}"
                                TextColor="White"
                                CornerRadius="11"
                                HeightRequest="42"
                                Padding="15,7" />

                        </Grid>

                        <Editor
                            Text="{Binding DescriptionDraft}"
                            MinimumHeightRequest="120"
                            AutoSize="TextChanges"
                            Placeholder="Escribe una breve descripción sobre ti..."
                            PlaceholderColor="#8390A0"
                            TextColor="{StaticResource TitleText}"
                            BackgroundColor="{StaticResource PatientPageBackground}" />

                        <Label
                            Text="Demostración local: la foto y la descripción se guardan solo en este dispositivo."
                            Style="{StaticResource CardMetaStyle}" />

                    </VerticalStackLayout>

                </Border>

                <!-- DESCRIPCIÓN GUARDADA -->
                <Border Style="{StaticResource PatientCardStyle}">

                    <VerticalStackLayout Spacing="9">

                        <Label
                            Text="Descripción del perfil"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TitleText}" />

                        <Label
                            Text="{Binding Description}"
                            Style="{StaticResource CardBodyStyle}"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>

                <!-- INFORMACIÓN PERSONAL -->
                <Border Style="{StaticResource PatientCardStyle}">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Información personal"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TitleText}" />

                        <Label Text="Documento" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding Profile.Document, TargetNullValue='—'}" Style="{StaticResource FieldValueStyle}" />

                        <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" />

                        <Label Text="Correo electrónico" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding Profile.Email, TargetNullValue='—'}" Style="{StaticResource FieldValueStyle}" />

                        <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" />

                        <Label Text="Sexo" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding Profile.Sex}" Style="{StaticResource FieldValueStyle}" />

                        <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" />

                        <Label Text="Fecha de nacimiento" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding Profile.BirthDateLabel}" Style="{StaticResource FieldValueStyle}" />

                        <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" />

                        <Label Text="Teléfono" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding Profile.PhoneNumber, TargetNullValue='—'}" Style="{StaticResource FieldValueStyle}" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
