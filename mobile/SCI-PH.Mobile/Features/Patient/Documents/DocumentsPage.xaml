<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SCI_PH.Mobile.Features.Patient.Documents.DocumentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SCI_PH.Mobile.Features.Patient.ViewModels"
    xmlns:dtos="clr-namespace:SCI_PH.Mobile.Features.Patient.Models.Dtos"
    x:DataType="vm:DocumentsViewModel"
    Title="Documentos"
    BackgroundColor="{StaticResource PatientPageBackground}">

    <CollectionView
        ItemsSource="{Binding Documents}"
        SelectionMode="None"
        Margin="20,0">

        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="17" />
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <VerticalStackLayout Padding="0,20,0,17" Spacing="17">

                <Label
                    Text="Documentos"
                    Style="{StaticResource PatientPageTitleStyle}" />

                <Label
                    Text="Documentos clínicos autorizados para tu cuenta."
                    Style="{StaticResource CardBodyStyle}" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource ColorPrimary}" />

                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    Style="{StaticResource ErrorTextStyle}" />

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.EmptyView>
            <Label
                Text="Todavía no hay documentos disponibles."
                IsVisible="{Binding IsNotBusy}"
                Style="{StaticResource CardMetaStyle}" />
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="dtos:DocumentItemDto">

                <Border Style="{StaticResource PatientCardStyle}">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="14">

                        <Border
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="{StaticResource InfoBackground}"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label
                                Text="{Binding Icon}"
                                FontSize="26"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="{Binding Title}"
                                Style="{StaticResource CardTitleStyle}" />

                            <Label
                                Text="{Binding Subtitle}"
                                Style="{StaticResource CardMetaStyle}" />

                            <Label
                                Text="{Binding DateLabel}"
                                FontSize="12"
                                TextColor="{StaticResource MutedText}" />

                        </VerticalStackLayout>

                        <!-- Abrir documentos llegará con el Mobile BFF; de momento avisa "Disponible próximamente". -->
                        <Button
                            Grid.Column="2"
                            Text="Ver"
                            Command="{Binding OpenDocumentCommand, Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, x:DataType=vm:DocumentsViewModel}"
                            CommandParameter="{Binding .}"
                            BackgroundColor="{StaticResource ColorPrimary}"
                            TextColor="{StaticResource TextOnPrimary}"
                            CornerRadius="10"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="20" Color="Transparent" />
        </CollectionView.Footer>

    </CollectionView>

</ContentPage>
