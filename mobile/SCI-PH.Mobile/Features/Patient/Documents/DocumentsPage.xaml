<?xml version="1.0" encoding="utf-8" ?>

<!--
    Documentos clínicos: todavía no hay almacenamiento de documentos ni descarga en SCI-PH, así que esta pantalla no
    muestra documentos (ni ficticios) y lo dice. Llegará con la vertical de documentos (ADR-015, decisión 6).
-->
<ContentPage
    x:Class="SCI_PH.Mobile.Features.Patient.Documents.DocumentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Documentos"
    BackgroundColor="{StaticResource PatientPageBackground}">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="17">

            <Label
                Text="Documentos"
                Style="{StaticResource PatientPageTitleStyle}" />

            <Border Style="{StaticResource PatientCardStyle}">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Todavía no disponible"
                        Style="{StaticResource CardTitleStyle}" />

                    <Label
                        Text="La consulta de documentos clínicos aún no está disponible en la app. Tu centro de salud puede entregarte tus documentos mientras tanto."
                        Style="{StaticResource CardBodyStyle}" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
