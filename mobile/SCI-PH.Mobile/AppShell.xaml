<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SCI_PH.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SCI_PH.Mobile"
    xmlns:nav="clr-namespace:SCI_PH.Mobile.Common.Navigation"
    xmlns:entry="clr-namespace:SCI_PH.Mobile.Common.Entry"
    xmlns:patient="clr-namespace:SCI_PH.Mobile.Features.Patient"
    xmlns:patientHome="clr-namespace:SCI_PH.Mobile.Features.Patient.Home"
    xmlns:patientProfile="clr-namespace:SCI_PH.Mobile.Features.Patient.Profile"
    xmlns:patientHistory="clr-namespace:SCI_PH.Mobile.Features.Patient.History"
    xmlns:patientResults="clr-namespace:SCI_PH.Mobile.Features.Patient.Results"
    xmlns:patientDocuments="clr-namespace:SCI_PH.Mobile.Features.Patient.Documents"
    xmlns:patientAi="clr-namespace:SCI_PH.Mobile.Features.Patient.Ai"
    x:DataType="local:AppShell"
    Shell.BackgroundColor="{StaticResource SciNavy}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    FlyoutBehavior="Disabled"
    FlyoutBackgroundColor="{StaticResource SciNavy}"
    Title="SCI-PH">

    <!--
        Una sola app para dos tipos de usuario (ver mobile/README.md):
          - Personal clínico (Paramedic): login real pendiente; hoy entra directamente al prototipo.
          - Paciente (Patient): QR + verificación facial, simulados hasta integrar el Mobile BFF.
        Los flujos de acceso (NewEmergency, QrAccess → FaceVerify) se apilan sobre la entrada y los registra cada
        feature. Aquí solo se declaran la entrada y las secciones del área del paciente.
    -->

    <!-- CABECERA DEL MENÚ (área del paciente): nombre tomado de la sesión -->
    <Shell.FlyoutHeader>
        <Grid Padding="22,35,22,24" BackgroundColor="{StaticResource SciNavy}">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border
                    WidthRequest="90"
                    HeightRequest="90"
                    BackgroundColor="White"
                    Stroke="White"
                    StrokeThickness="3">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="45" />
                    </Border.StrokeShape>
                    <Image Source="patient_avatar.png" Aspect="AspectFill" />
                </Border>
                <Label
                    Text="{Binding PatientDisplayName}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ENTRADA COMPARTIDA -->
    <ShellContent
        Title="SCI-PH"
        Route="{x:Static nav:AppRoutes.Entry}"
        ContentTemplate="{DataTemplate entry:EntryPage}"
        Shell.FlyoutItemIsVisible="False" />

    <!-- Paramedic (Rol 6): sin menú; su flujo se apila sobre la entrada (RegisterParamedicRoutes). -->

    <!-- Patient (Rol 7): área con sesión de paciente -->
    <FlyoutItem Title="Inicio" Route="{x:Static patient:PatientRoutes.Home}">
        <ShellContent Title="Inicio" ContentTemplate="{DataTemplate patientHome:HomePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Mi perfil" Route="{x:Static patient:PatientRoutes.Profile}">
        <ShellContent Title="Mi perfil" ContentTemplate="{DataTemplate patientProfile:ProfilePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Historial clínico" Route="{x:Static patient:PatientRoutes.History}">
        <ShellContent Title="Historial clínico" ContentTemplate="{DataTemplate patientHistory:HistoryPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Resultados" Route="{x:Static patient:PatientRoutes.Results}">
        <ShellContent Title="Resultados" ContentTemplate="{DataTemplate patientResults:ResultsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Documentos" Route="{x:Static patient:PatientRoutes.Documents}">
        <ShellContent Title="Documentos" ContentTemplate="{DataTemplate patientDocuments:DocumentsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Asistente IA" Route="{x:Static patient:PatientRoutes.Assistant}">
        <ShellContent Title="SCI-PH AI" ContentTemplate="{DataTemplate patientAi:AiAssistantPage}" />
    </FlyoutItem>

    <MenuItem Text="Cerrar sesión" Command="{Binding PatientLogoutCommand}" />

</Shell>
