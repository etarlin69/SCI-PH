<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net9.0 solo compila la lógica sin interfaz para mobile/tests (no es una app ni se publica). -->
		<TargetFrameworks>net9.0;net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType Condition="'$(TargetFramework)' != 'net9.0'">Exe</OutputType>
		<RootNamespace>SCI_PH.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Compila también los bindings con Source (p. ej. RelativeSource en las plantillas de CollectionView). -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>SCI-PH.Mobile</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.sciph.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0D1F33" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D1F33" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Avatar por defecto del paciente: se muestra como máximo a 132 x 132. -->
		<MauiImage Update="Resources\Images\patient_avatar.png" BaseSize="132,132" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!--
		Android, solo Debug: HTTP hacia el Mobile BFF local (10.0.2.2 y localhost). Release no lo incluye.
		Dispositivo físico por Wi-Fi (LocalDevice): con -p:MobileBffBaseUrl=http://<IPv4 privada>:<puerto> se genera en obj/
		una copia que además permite HTTP solo hacia ese host. Únicamente IPv4 privadas (10/8, 172.16/12, 192.168/16); otro
		host por HTTP detiene la compilación. Ninguna IP queda en el repositorio.
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And $(MobileBffBaseUrl.StartsWith('http://'))">
		<SciphLocalDeviceHost>$([System.Text.RegularExpressions.Regex]::Match('$(MobileBffBaseUrl)', '^http://((10\.\d{1,3}|172\.(1[6-9]|2\d|3[01])|192\.168)\.\d{1,3}\.\d{1,3})(:\d{1,5})?/?$').Groups[1].Value)</SciphLocalDeviceHost>
		<SciphNetworkSecurityConfig>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\sciph-local-device\network_security_config.xml</SciphNetworkSecurityConfig>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(SciphNetworkSecurityConfig)' == ''">
		<AndroidResource Include="Platforms\Android\DebugResources\xml\network_security_config.xml" Link="Platforms\Android\Resources\xml\network_security_config.xml" />
	</ItemGroup>

	<ItemGroup Condition="'$(SciphNetworkSecurityConfig)' != ''">
		<AndroidResource Include="$(SciphNetworkSecurityConfig)" Link="Platforms\Android\Resources\xml\network_security_config.xml" />
	</ItemGroup>

	<Target Name="SciphWriteLocalDeviceNetworkSecurityConfig" BeforeTargets="PrepareForBuild" Condition="'$(SciphNetworkSecurityConfig)' != ''">
		<Error Condition="'$(SciphLocalDeviceHost)' == ''" Text="MobileBffBaseUrl por HTTP solo se admite hacia una IPv4 privada de la red local (http://10.x, 172.16-31.x o 192.168.x, con puerto opcional). Usa https:// para cualquier otro host." />
		<PropertyGroup>
			<_SciphDebugConfig>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Platforms\Android\DebugResources\xml\network_security_config.xml'))</_SciphDebugConfig>
			<_SciphLocalDeviceConfig>$(_SciphDebugConfig.Replace('&lt;domain includeSubdomains="false"&gt;localhost&lt;/domain&gt;', '&lt;domain includeSubdomains="false"&gt;localhost&lt;/domain&gt;%0D%0A        &lt;domain includeSubdomains="false"&gt;$(SciphLocalDeviceHost)&lt;/domain&gt;'))</_SciphLocalDeviceConfig>
		</PropertyGroup>
		<Error Condition="'$(_SciphLocalDeviceConfig)' == '$(_SciphDebugConfig)'" Text="No se pudo añadir el host local al network security config de Debug." />
		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SciphNetworkSecurityConfig)'))" />
		<WriteLinesToFile File="$(SciphNetworkSecurityConfig)" Lines="$(_SciphLocalDeviceConfig)" Overwrite="true" WriteOnlyWhenDifferent="true" />
	</Target>

	<!-- Dirección del Mobile BFF fijada al compilar (backend desplegado o dispositivo físico): -p:MobileBffBaseUrl=https://... -->
	<ItemGroup Condition="'$(MobileBffBaseUrl)' != ''">
		<AssemblyMetadata Include="MobileBffBaseUrl" Value="$(MobileBffBaseUrl)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.6.0" />
	</ItemGroup>

</Project>
